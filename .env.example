# Copy to .env in the project root (gitignored), OR create config/.env next to config.php on Hostinger.
# HEADCOUNT_DB_* overrides DB_* when both are set (see config.php).
# Hostinger from your PC: set HEADCOUNT_DB_HOST to the Remote MySQL hostname from hPanel (not localhost).
# Easiest on Hostinger: copy config/database.php.example → config/database.php and paste the MySQL password.

HEADCOUNT_DB_HOST=
HEADCOUNT_DB_NAME=u525556582_events
HEADCOUNT_DB_USER=u525556582_events
HEADCOUNT_DB_PASSWORD=

# Production site URLs (required on Hostinger when config.php still has localhost defaults)
# Use your live domain — password reset, magic links, and QR codes read these.
HEADCOUNT_APP_URL=https://events.example.org/Headcount
HEADCOUNT_PORTAL_URL=https://events.example.org/Headcount

# Public portal / QR / share links when different from HEADCOUNT_APP_URL
# HEADCOUNT_PORTAL_PUBLIC_BASE_URL=
