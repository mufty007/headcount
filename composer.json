{
    "name": "headcount/events-platform",
    "description": "Community Events & Attendance Management Platform",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "stripe/stripe-php": "^10.0",
        "endroid/qr-code": "^5.0",
        "dompdf/dompdf": "2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Headcount\\": "src/"
        },
        "classmap": [
            "src/Helpers/EventTicketTypesPersistence.php"
        ],
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Headcount\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.12"
        }
    }
}
